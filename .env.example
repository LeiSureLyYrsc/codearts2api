# Required bootstrap key for /v1/* and /admin/*, and for logging into the WebUI.
# You can later change it in the WebUI; the env value remains the default used
# when no key has been saved to data/config.json.
CA2A_API_KEY=change-me
# CODEARTS2API_API_KEY=

# Local gateway bind address (env-only; not writable from WebUI or data/config.json).
CA2A_HOST=127.0.0.1
CA2A_PORT=8787

# Runtime directories (env-only). Never commit these directories.
# Account credentials (AK/SK), check-in schedule, and other runtime settings
# live in data/config.json. Copy config.example.json to data/config.json and
# edit it, or configure them in the WebUI after startup.
CA2A_DATA_DIR=data
CA2A_AUTH_DIR=auths
