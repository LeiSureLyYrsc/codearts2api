# Optional bootstrap IAM credentials. If the account pool is empty on first start,
# these are imported as an enabled account named "env". After that, manage accounts
# in the WebUI at http://127.0.0.1:8787/ (the pool file data/config.json is authoritative).
# Create or view access keys at:
# https://console.huaweicloud.com/iam/#/mine/accessKey
CODEARTS_AK=
CODEARTS_SK=

# Optional STS temporary security token. When set, requests include a signed X-Security-Token header.
CODEARTS_SECURITY_TOKEN=

# Optional project id. When set, requests include a signed X-Project-Id header.
CODEARTS_PROJECT_ID=

# Official-client snap-access gateway (inference / models / check-in). Not in the public API catalog.
SNAP_BASE_URL=https://snap-access.cn-north-4.myhuaweicloud.com

# Local gateway bind address.
CA2A_HOST=127.0.0.1
CA2A_PORT=8787

# Required bootstrap key for /v1/* and /admin/*, and for logging into the WebUI.
# Either name is accepted. You can later change it in the WebUI; the env value remains
# the default used when no key has been saved to data/config.json.
CA2A_API_KEY=change-me
# CODEARTS2API_API_KEY=

# In-process daily check-in (Asia/Shanghai). Cron is 5-field (min hour dom mon dow).
CA2A_TIMEZONE=Asia/Shanghai
CA2A_CHECKIN_CRON=0 8 * * *
CA2A_CHECKIN_RUN_ON_STARTUP=true
CA2A_SCHEDULER_ENABLED=true

# Campaign matching: default official daily check-in type. Set claim-all to also claim other claimable campaigns.
CA2A_CAMPAIGN_TYPE=USER_LOGIN
CA2A_CHECKIN_CLAIM_ALL=false

# Dynamic model list cache (seconds). GET /v1/models?refresh=true bypasses the cache.
CA2A_MODEL_CACHE_TTL=60

# Optional. Official clients sometimes attach this AFTER signing (it is not part of the canonical request).
# Leave empty to omit the header. Example: zh-cn
CA2A_X_LANGUAGE=

# Optional hook only. Do not invent a host. If you later find a reliable official opengw base URL,
# set it here to enable POST {OPENGW_BASE_URL}/api/v1/benefit/claim (empty JSON body).
# This is separate from the daily USER_LOGIN check-in.
OPENGW_BASE_URL=https://opengw.developer.huaweicloud.com

CA2A_LOG_LEVEL=INFO

# Upstream HTTP timeouts (seconds). Stream read timeout can be longer.
CA2A_HTTP_TIMEOUT=60
CA2A_HTTP_STREAM_TIMEOUT=300

# Credential source filter for the account pool: auto (all kinds), oauth, or env (AK/SK only).
CA2A_CREDENTIAL_SOURCE=auto

# Local directory for OAuth session files (auths/session.json and auths/<account-id>.json).
# Never commit this.
CA2A_AUTH_DIR=auths

# Account pool and WebUI-persisted settings (data/config.json, mode 0600). Never commit this.
CA2A_DATA_DIR=data

# Chat account selection: round_robin (default), first_available, or random.
CA2A_POOL_STRATEGY=round_robin
# After an upstream 401/403/429/5xx, skip that account for this many seconds (failover only).
CA2A_COOLDOWN_SECONDS=60

# Official CodeArts CLI (26.11.11) SSO values. Override only if an official client uses a different id.
CA2A_OAUTH_CLIENT_ID=CodeArts_Tui
CA2A_OAUTH_PORTAL_URL=https://codearts.huaweicloud.com/portal
CA2A_OAUTH_STS_URL=https://sts.cn-north-4.myhuaweicloud.com
CA2A_OAUTH_LOCALE=zh-cn
# 0 = let the OS assign a loopback port (same as the official CLI).
CA2A_OAUTH_CALLBACK_PORT=0
